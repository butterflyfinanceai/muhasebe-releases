{
  "name": "butterfly-finance-ai",
  "private": true,
  "version": "1.1.57",
  "description": "Yapay Zeka Destekli Ön Muhasebe Programı",
  "author": {
    "name": "Butterfly Finance AI",
    "email": "info@butterflyfinance.ai"
  },
  "main": "dist-electron/main.js",
  "homepage": "./",
  "build": {
    "appId": "com.butterflyfinance.ai",
    "productName": "Butterfly Finance AI",
    "directories": {
      "output": "dist-electron/release"
    },
    "files": [
      "dist-electron/**/*",
      "!dist-electron/release/**/*",
      "dist/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Butterfly Finance AI",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "language": "2055"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "butterflyfinanceai",
        "repo": "muhasebe-releases",
        "private": false
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/butterflyfinanceai/muhasebe-releases.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron .",
    "build": "npm version patch --no-git-tag-version && tsc -b && vite build && tsc -p tsconfig.electron.json && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@netlify/functions": "^5.1.1",
    "better-sqlite3": "^12.5.0",
    "drizzle-orm": "^0.44.7",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "firebase": "^11.10.0",
    "groq-sdk": "^0.37.0",
    "lucide-react": "^0.561.0",
    "recharts": "^3.6.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "dexie": "^4.2.1",
    "drizzle-kit": "^0.31.7",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jimp": "^1.6.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "netlify-cli": "^23.12.3",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1",
    "react-to-print": "^3.2.0",
    "rxdb": "^16.21.1",
    "rxdb-hooks": "^5.0.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "uuid": "^13.0.0",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3",
    "xlsx": "^0.18.5"
  }
}
